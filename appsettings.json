{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Auth": {
    "AccessTokenMinutes": 10,
    "SessionDays": 7,
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "ResetTokenMinutes": 30,
    "ResetCooldownSeconds": 60,
    "MinimumPasswordLength": 12,
    "PasswordHashIterations": 210000,
    "RateLimitPermitCount": 10,
    "RateLimitWindowSeconds": 60,
    "MaxActiveSessions": 10
  },
  "Jwt": {
    "Issuer": "SignIt.Api",
    "Audience": "SignIt.Bff",
    "KeyId": "signit-auth-v1",
    "PrivateKeyPem": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Proxy": {
    "KnownProxies": []
  },
  "DataProtection": {
    "KeyDirectory": ".data/keys"
  },
  "Email": {
    "WorkerEnabled": false,
    "SandboxMode": true,
    "RecipientAllowlist": [],
    "From": "",
    "ReplyTo": "",
    "ResetPasswordUrl": "https://app.signit.example/reset-password",
    "PollSeconds": 10,
    "MaxAttempts": 5,
    "HttpTimeoutSeconds": 30,
    "DailyBudget": 100,
    "MonthlyBudget": 3000
  },
  "Resend": {
    "ApiKey": "",
    "WebhookSecret": "",
    "WebhookToleranceSeconds": 300
  },
  "Llm": {
    "BaseUrl": "https://api.openai.com/v1",
    "ApiKey": "",
    "Model": "gpt-4o-mini",
    "TimeoutSeconds": 30,
    "Temperature": 0.2,
    "MaxTokens": 1000
  }
}
