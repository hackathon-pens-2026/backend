# Salin file ini menjadi .env (ter-ignore git) dan isi nilai sebenarnya.
# Loader: Infrastructure/Configuration/DotEnv.cs — tidak menimpa environment variable yang sudah ada.
# Nilai quoted boleh multi-baris (mis. PEM).

ConnectionStrings__DefaultConnection=Host=localhost;Port=5434;Database=hackathondb;Username=<user>;Password=<secret>

Jwt__PrivateKeyPem="<RSA private key PEM minimal 2048-bit>"

Resend__ApiKey=<resend-api-key>
Resend__WebhookSecret=<resend-webhook-signing-secret>

# LLM OpenAI-compatible configuration (Groq / OpenAI / OpenRouter / Ollama)
Llm__BaseUrl=https://api.openai.com/v1
Llm__ApiKey=<llm-api-key>
Llm__Model=gpt-4o-mini

# Password akun seed untuk provisioning (manifest provisioning.local.json).
SIGNIT_SEED_STUDENT_PASSWORD=<password>
SIGNIT_SEED_DAGRI_PASSWORD=<password>
SIGNIT_SEED_BAAK_PASSWORD=<password>
SIGNIT_SEED_MANAGEMENT_PASSWORD=<password>
